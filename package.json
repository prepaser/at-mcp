{
  "name": "at-mcp",
  "version": "0.1.2",
  "type": "module",
  "description": "A local MCP server for checking minimum task durations.",
  "license": "AGPL-3.0-only",
  "bin": {
    "at-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "src",
    "scripts",
    "tsconfig.json",
    "tsconfig.build.json",
    "LICENSE"
  ],
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "start": "node src/index.ts",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "check:package": "pnpm build && node scripts/check-package.ts",
    "test": "node --test test/*.test.ts",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm check && pnpm test && pnpm check:package"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.2.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "@types/node": "26.6.3",
    "typescript": "7.0.2"
  }
}
